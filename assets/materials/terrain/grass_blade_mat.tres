[sub_resource type="Shader" id="Shader_5h1dc"]
code = "shader_type spatial;
render_mode cull_back, depth_draw_always, alpha_to_coverage;
#include \"res://src/shaders/utils/rand.gdshaderinc\"
#include \"res://src/shaders/utils/color_manipulation.gdshaderinc\" 


const float NOISE_SCALE = .01;
const vec3 LIGHT_SAMPLE_OFFSET = vec3(0,.7,0);
const int MAX_BLADE_VARIATIONS = 8;

group_uniforms Grass;
uniform sampler2D grass_noise_tex;
uniform sampler2D[MAX_BLADE_VARIATIONS] blade_textures;
uniform int[MAX_BLADE_VARIATIONS] blade_weights;
uniform bool[MAX_BLADE_VARIATIONS] blade_use_albedo_noise;
uniform float blades_group_noise;
uniform float roughness: hint_range(0.0, 1.0) = 1.0;
uniform float specular: hint_range(0.0, 1.0, 0.01) = 0.2;


group_uniforms Lighting;
uniform float light_strength: hint_range(0.0, 1.0) = .25;
uniform float step_blur: hint_range(0.0, 0.1) = .015;
uniform float cutoff_light: hint_range(0.0, 1.0) = .2;
uniform float weight_light: hint_range(0.0, 1.0) = .3;
uniform float cutoff_penumbra: hint_range(0.0, 1.0) = .1;
uniform float weight_penumbra: hint_range(0.0, 1.0) = .15;

group_uniforms Wind;
uniform float wind_bend_ammount = 1.0;
uniform float sway_back: hint_range(0.0, 1.0) = 1.0;

global uniform sampler2D grass_albedo_texture;
global uniform sampler2D wind_noise_texture;
global uniform vec3 wind_direction;
global uniform float wind_scale;
global uniform float wind_speed;
global uniform float wind_strength;

//varying flat int instance_id;
varying vec3 node_pos_world;
varying flat int blade_variation_index;


void vertex() {
	// Billboard Mode: Enabled
	MODELVIEW_MATRIX = VIEW_MATRIX * mat4(
			MAIN_CAM_INV_VIEW_MATRIX[0],
			MAIN_CAM_INV_VIEW_MATRIX[1],
			MAIN_CAM_INV_VIEW_MATRIX[2],
			MODEL_MATRIX[3]);

	// Billboard Keep Scale: Enabled
	MODELVIEW_MATRIX = MODELVIEW_MATRIX * mat4(
			vec4(length(MODEL_MATRIX[0].xyz), 0.0, 0.0, 0.0),
			vec4(0.0, length(MODEL_MATRIX[1].xyz), 0.0, 0.0),
			vec4(0.0, 0.0, length(MODEL_MATRIX[2].xyz), 0.0),
			vec4(0.0, 0.0, 0.0, 1.0));
	MODELVIEW_NORMAL_MATRIX = mat3(MODELVIEW_MATRIX);
	
	// Set pos_view for cell light calculation 
	node_pos_world = NODE_POSITION_WORLD;
	
	// Wind
	vec3 vertex = (MODEL_MATRIX * vec4(VERTEX,1)).xyz; // use uv as vertex's global .xz
	vertex = vertex * wind_scale - (wind_speed * TIME * wind_direction); // pan UV
	vec3 displacement = texture(wind_noise_texture, vertex.xz).xyz;
	displacement = displacement * (1.0 + sway_back) - sway_back;
	displacement *= wind_bend_ammount * wind_strength;
	float uv_mask = 1.0 - UV.y;
	vec3 wind_direction_view = (VIEW_MATRIX * vec4(wind_direction,0)).xyz; //correct direction to follow world instead of view
	VERTEX += displacement * uv_mask * wind_direction_view;
	
	// Grass blade variation
	vec3 vertex_global = NODE_POSITION_WORLD;
	float noise = texture(grass_noise_tex, (vertex_global.xz + vec2((randf(NODE_POSITION_WORLD)-.5)*blades_group_noise)) * NOISE_SCALE).x;
	int intervals = 0;
	for (int i=0; i<MAX_BLADE_VARIATIONS; i++) {
		intervals += blade_weights[i];
	}
	int rand_val = int(noise * float(intervals) + .999);
	for (int i=0; i<MAX_BLADE_VARIATIONS; i++) {
		if (blade_weights[i] >= rand_val) {
			blade_variation_index = i;
			break;
		}
		else rand_val -= blade_weights[i];
	}
}

void fragment() {
	// Color texture
	vec3 vertex = node_pos_world;
	if (!blade_use_albedo_noise[blade_variation_index]) {
		ALBEDO = texture(grass_albedo_texture, (vertex.xz) * NOISE_SCALE).xyz;
		ALBEDO *= texture(blade_textures[blade_variation_index], UV).rgb;
	}
	else ALBEDO *= texture(blade_textures[blade_variation_index], UV).rgb;
	
	SPECULAR = specular;
	ROUGHNESS = roughness;
	NORMAL = (VIEW_MATRIX * vec4(NORMAL,0)).xyz; // normal always pointing up for constant shading
	
	// Set alpha mask
	ALPHA *= step(.9,texture(blade_textures[blade_variation_index], UV).a);
	
	// Set vertex as node's position for cell light calculation 
	LIGHT_VERTEX = (VIEW_MATRIX*vec4(node_pos_world + LIGHT_SAMPLE_OFFSET,1.)).xyz;
}

void light() {
	float diffuse = 1.0;
	float diffuse_light = smoothstep(cutoff_light-step_blur, cutoff_light+step_blur, diffuse) * weight_light;
	float diffuse_penumbra = smoothstep(cutoff_penumbra-step_blur, cutoff_penumbra+step_blur, diffuse) * weight_penumbra;
	
	diffuse = (diffuse_light + diffuse_penumbra) * light_strength;
	
	DIFFUSE_LIGHT += diffuse * ATTENUATION * LIGHT_COLOR / PI;
	SPECULAR_LIGHT += diffuse * ATTENUATION * LIGHT_COLOR / PI;
}
"

[sub_resource type="NoiseTexture2D" id="NoiseTexture2D_b6u2p"]
noise = ExtResource("3_fixht")

[resource]
render_priority = 0
shader = SubResource("Shader_5h1dc")
shader_parameter/grass_noise_tex = SubResource("NoiseTexture2D_b6u2p")
shader_parameter/blade_textures = Array[Texture2D]([ExtResource("1_dgdsr"), ExtResource("2_prpc8"), ExtResource("3_1vbpm"), ExtResource("4_hxbq2"), ExtResource("5_6gljt"), ExtResource("6_xjabm"), ExtResource("7_1vbpm"), ExtResource("8_hxbq2")])
shader_parameter/blade_weights = PackedInt32Array(8, 0, 0, 0, 0, 0, 0, 0)
shader_parameter/blade_use_albedo_noise = PackedInt32Array(0, 1, 1, 1, 1, 1, 1, 1)
shader_parameter/blades_group_noise = 100.0
shader_parameter/roughness = 1.0
shader_parameter/specular = 0.2
shader_parameter/light_strength = 0.1150000054625
shader_parameter/step_blur = 0.015
shader_parameter/cutoff_light = 0.2
shader_parameter/weight_light = 0.26400001254
shader_parameter/cutoff_penumbra = 0.1
shader_parameter/weight_penumbra = 0.10000000475
shader_parameter/wind_bend_ammount = 1.0
shader_parameter/sway_back = 1.0
