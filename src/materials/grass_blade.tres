[gd_resource type="ShaderMaterial" format=3 uid="uid://wra6rbgyy2tv"]

[sub_resource type="Shader" id="Shader_5h1dc"]
code = "// NOTE: Shader automatically converted from Godot Engine 4.7.stable's StandardMaterial3D.

shader_type spatial;
render_mode blend_mix, cull_disabled, diffuse_burley, specular_schlick_ggx, world_vertex_coords, depth_draw_always;

group_uniforms Grass;
uniform sampler2D albedo_noise_texture;
const float NOISE_SCALE = .01;
uniform sampler2D alpha_texture;
uniform float roughness: hint_range(0.0, 1.0);
uniform float specular: hint_range(0.0, 1.0, 0.01);
uniform float transparency_mask_radius: hint_range(0.0, 30.0);
uniform float transparency_exponent: hint_range(0.0, 10.0);

group_uniforms Lighting;
uniform float light_strength: hint_range(0.0, 1.0) = .25;
uniform float step_blur: hint_range(0.0, 0.1) = .015;
uniform float cutoff_light: hint_range(0.0, 1.0) = .2;
uniform float weight_light: hint_range(0.0, 1.0) = .3;
uniform float cutoff_penumbra: hint_range(0.0, 1.0) = .1;
uniform float weight_penumbra: hint_range(0.0, 1.0) = .15;

global uniform vec3 player_position;

void fragment() {
	vec3 vertex = (inverse(VIEW_MATRIX) * vec4(VERTEX,1)).xyz;
	ALBEDO = texture(albedo_noise_texture, (vertex.xz) * NOISE_SCALE).xyz;
	
	SPECULAR = specular;

	vec4 roughness_texture_channel = vec4(1.0, 0.0, 0.0, 0.0);
	ROUGHNESS = roughness;
	
	// Transparency with player position
	vec3 player_screen_pos = (VIEW_MATRIX * vec4(player_position, 1)).xyz;
	// for fragment, use: ALPHA = clamp(distance(VERTEX, player_screen_pos)/transparency_mask_radius, 0, 1);
	ALPHA = clamp(distance(VERTEX, player_screen_pos)/transparency_mask_radius, 0, 1);
	ALPHA = pow(ALPHA, transparency_exponent);
	
	ALPHA *= step(.9, texture(alpha_texture, UV).a);
}

void light() {
	float diffuse = 1.0;
	float diffuse_light = smoothstep(cutoff_light-step_blur, cutoff_light+step_blur, diffuse) * weight_light;
	float diffuse_penumbra = smoothstep(cutoff_penumbra-step_blur, cutoff_penumbra+step_blur, diffuse) * weight_penumbra;
	
	diffuse = (diffuse_light + diffuse_penumbra) * light_strength;
	
	DIFFUSE_LIGHT += diffuse * ATTENUATION * LIGHT_COLOR / PI;
	SPECULAR_LIGHT += diffuse * ATTENUATION * LIGHT_COLOR / PI;
}
"

